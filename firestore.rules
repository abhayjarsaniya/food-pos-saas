rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.email == 'superadmin@foodpos.app'
      );
    }

    function isShopOwner(businessId) {
      return request.auth != null && (
        request.auth.uid == businessId ||
        request.auth.token.businessId == businessId
      );
    }

    function isShopMember(businessId) {
      return request.auth != null && (
        isShopOwner(businessId) ||
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
      );
    }

    // Platform settings & shops directory
    match /platform/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Public lookup for staff custom login IDs (e.g. cashier01) to enable secure sign-in
    match /loginIds/{loginId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Business scoped collections
    match /businesses/{businessId} {
      allow read, write: if isShopOwner(businessId) || isSuperAdmin();

      match /profile/{docId} {
        allow read: if isShopMember(businessId);
        allow write: if isShopOwner(businessId) || isSuperAdmin();
      }

      match /settings/{docId} {
        allow read: if isShopMember(businessId);
        allow write: if isShopOwner(businessId) || isSuperAdmin();
      }

      match /members/{memberId} {
        allow read: if isShopMember(businessId);
        allow write: if isShopOwner(businessId) || isSuperAdmin();
      }

      match /meta/{docId} {
        allow read, write: if isShopMember(businessId);
      }

      match /categories/{categoryId} {
        allow read: if isShopMember(businessId);
        allow write: if isShopOwner(businessId) || isSuperAdmin();
      }

      match /menuItems/{itemId} {
        allow read: if isShopMember(businessId);
        allow write: if isShopOwner(businessId) || isSuperAdmin();
      }

      match /orders/{orderId} {
        allow read, create, update: if isShopMember(businessId);
        allow delete: if isShopOwner(businessId) || isSuperAdmin();

        match /payments/{paymentId} {
          allow read, create: if isShopMember(businessId);
          allow update, delete: if isShopOwner(businessId) || isSuperAdmin();
        }
      }

      match /tables/{tableId} {
        allow read, write: if isShopMember(businessId);
      }

      match /customers/{customerId} {
        allow read, write: if isShopMember(businessId);
      }

      match /suppliers/{supplierId} {
        allow read, write: if isShopMember(businessId);
      }

      match /inventory/{inventoryId} {
        allow read, write: if isShopMember(businessId);
      }

      match /purchaseOrders/{poId} {
        allow read, write: if isShopMember(businessId);
      }

      match /stockMovements/{movementId} {
        allow read, create: if isShopMember(businessId);
        allow update, delete: if isShopOwner(businessId) || isSuperAdmin();
      }

      match /supplierPayments/{paymentId} {
        allow read, write: if isShopMember(businessId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isShopMember(businessId);
      }

      match /activityLogs/{logId} {
        allow read, create: if isShopMember(businessId);
        allow update, delete: if isShopOwner(businessId) || isSuperAdmin();
      }
    }
  }
}
